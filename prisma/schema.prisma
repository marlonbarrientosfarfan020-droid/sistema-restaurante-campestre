generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id         String     @id @default(cuid())
  nombre     String
  ruc        String?    @unique
  direccion  String?
  telefono   String?
  correo     String?
  logoUrl    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  sucursales Sucursal[]
}

model Sucursal {
  id           String        @id @default(cuid())
  empresaId    String
  nombre       String
  codigo       String
  direccion    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  atenciones   Atencion[]
  categorias   Categoria[]
  comprobantes Comprobante[]
  pagos        Pago[]
  pedidos      Pedido[]
  productos    Producto[]
  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarios     Usuario[]
  zonas        Zona[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model Usuario {
  id                  String     @id @default(cuid())
  sucursalId          String
  nombres             String
  apellidos           String
  correo              String     @unique
  password            String
  rol                 RolUsuario
  activo              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  atencionesAsignadas Atencion[] @relation("MozoAtenciones")
  pedidosEntregados   Pedido[]   @relation("MozoEntregaPedido")
  pedidosRecibidos    Pedido[]   @relation("MozoRecibePedido")
  pedidosRegistrados  Pedido[]   @relation("UsuarioPedidos")
  sucursal            Sucursal   @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@index([sucursalId])
  @@index([rol, activo])
}

model Zona {
  id         String   @id @default(cuid())
  sucursalId String
  nombre     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mesas      Mesa[]
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([sucursalId, nombre])
  @@index([sucursalId])
}

model Mesa {
  id         String     @id @default(cuid())
  zonaId     String
  numero     Int
  nombre     String
  capacidad  Int        @default(4)
  qrCode     String?    @unique
  estado     EstadoMesa @default(LIBRE)
  activa     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  atenciones Atencion[]
  zona       Zona       @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  @@unique([zonaId, numero])
  @@index([zonaId])
  @@index([estado, activa])
}

model Categoria {
  id          String     @id @default(cuid())
  sucursalId  String
  codigo      String
  nombre      String
  descripcion String?
  activa      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  sucursal    Sucursal   @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  productos   Producto[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@index([nombre])
  @@index([activa])
}

model Producto {
  id                String          @id @default(cuid())
  sucursalId        String
  categoriaId       String
  codigo            String
  nombre            String
  descripcion       String?
  precioVenta       Decimal         @db.Decimal(10, 2)
  costo             Decimal         @default(0) @db.Decimal(10, 2)
  tiempoPreparacion Int             @default(15)
  imagenUrl         String?
  disponible        Boolean         @default(true)
  activo            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  controlaStock     Boolean         @default(false)
  stockActual       Decimal         @default(0) @db.Decimal(12, 3)
  stockMinimo       Decimal         @default(0) @db.Decimal(12, 3)
  detallesPedido    DetallePedido[]
  categoria         Categoria       @relation(fields: [categoriaId], references: [id])
  sucursal          Sucursal        @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@index([categoriaId])
  @@index([nombre])
  @@index([disponible, activo])
  @@index([controlaStock])
}

model Atencion {
  id                   String         @id @default(cuid())
  sucursalId           String
  mesaId               String
  mozoId               String?
  codigo               String
  estado               EstadoAtencion @default(ABIERTA)
  cantidadPersonas     Int            @default(1)
  metodoPagoPrevisto   MetodoPago?
  subtotal             Decimal        @default(0) @db.Decimal(12, 2)
  descuento            Decimal        @default(0) @db.Decimal(12, 2)
  total                Decimal        @default(0) @db.Decimal(12, 2)
  observacion          String?
  fechaApertura        DateTime       @default(now())
  fechaSolicitudCuenta DateTime?
  fechaPago            DateTime?
  fechaCierre          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  codigoAccesoMesa     String?
  tokenAccesoMesa      String?        @unique
  mesa                 Mesa           @relation(fields: [mesaId], references: [id])
  mozo                 Usuario?       @relation("MozoAtenciones", fields: [mozoId], references: [id])
  sucursal             Sucursal       @relation(fields: [sucursalId], references: [id])
  comprobantes         Comprobante[]
  pagos                Pago[]
  pedidos              Pedido[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@index([mesaId, estado])
  @@index([mozoId])
  @@index([fechaApertura])
  @@index([codigoAccesoMesa])
}

model Pedido {
  id               String          @id @default(cuid())
  sucursalId       String
  atencionId       String
  registradoPorId  String?
  recibidoPorId    String?
  entregadoPorId   String?
  numero           String
  origen           OrigenPedido
  estado           EstadoPedido    @default(NUEVO)
  observacion      String?
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  fechaPedido      DateTime        @default(now())
  fechaRecibido    DateTime?
  fechaPreparacion DateTime?
  fechaListo       DateTime?
  fechaEntrega     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  detalles         DetallePedido[]
  atencion         Atencion        @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  entregadoPor     Usuario?        @relation("MozoEntregaPedido", fields: [entregadoPorId], references: [id])
  recibidoPor      Usuario?        @relation("MozoRecibePedido", fields: [recibidoPorId], references: [id])
  registradoPor    Usuario?        @relation("UsuarioPedidos", fields: [registradoPorId], references: [id])
  sucursal         Sucursal        @relation(fields: [sucursalId], references: [id])

  @@unique([sucursalId, numero])
  @@index([sucursalId])
  @@index([atencionId, estado])
  @@index([registradoPorId])
  @@index([recibidoPorId])
  @@index([entregadoPorId])
  @@index([fechaPedido])
}

model DetallePedido {
  id               String              @id @default(cuid())
  pedidoId         String
  productoId       String
  cantidad         Decimal             @db.Decimal(10, 3)
  precioUnitario   Decimal             @db.Decimal(12, 2)
  subtotal         Decimal             @db.Decimal(12, 2)
  estado           EstadoDetallePedido @default(NUEVO)
  observacion      String?
  fechaPreparacion DateTime?
  fechaListo       DateTime?
  fechaEntrega     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  pedido           Pedido              @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto         Producto            @relation(fields: [productoId], references: [id])

  @@index([pedidoId, estado])
  @@index([productoId])
}

model Pago {
  id            String     @id @default(cuid())
  sucursalId    String
  atencionId    String
  metodo        MetodoPago
  monto         Decimal    @db.Decimal(12, 2)
  montoRecibido Decimal?   @db.Decimal(12, 2)
  vuelto        Decimal?   @db.Decimal(12, 2)
  referencia    String?
  observacion   String?
  fechaPago     DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  atencion      Atencion   @relation(fields: [atencionId], references: [id])
  sucursal      Sucursal   @relation(fields: [sucursalId], references: [id])

  @@index([sucursalId])
  @@index([atencionId])
  @@index([metodo])
  @@index([fechaPago])
}

model Comprobante {
  id               String          @id @default(cuid())
  sucursalId       String
  atencionId       String
  tipo             TipoComprobante
  serie            String
  correlativo      Int
  numero           String
  clienteDocumento String?
  clienteNombre    String?
  clienteDireccion String?
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  igv              Decimal         @default(0) @db.Decimal(12, 2)
  total            Decimal         @default(0) @db.Decimal(12, 2)
  emitido          Boolean         @default(true)
  fechaEmision     DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  atencion         Atencion        @relation(fields: [atencionId], references: [id])
  sucursal         Sucursal        @relation(fields: [sucursalId], references: [id])

  @@unique([sucursalId, tipo, serie, correlativo])
  @@unique([atencionId, tipo])
  @@index([sucursalId])
  @@index([atencionId])
  @@index([tipo])
  @@index([fechaEmision])
}

/// *
///  * =========================================================
///  * ENUMS
///  * =========================================================
enum TipoComprobante {
  NOTA_VENTA
  BOLETA
  FACTURA
}

enum RolUsuario {
  SUPERADMIN
  ADMINISTRADOR
  CAJERO
  MOZO
  COCINA
  BARRA
  GERENTE
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  PEDIDO_PENDIENTE
  CONSUMIENDO
  SOLICITO_CUENTA
  PAGADA
  LIMPIEZA
}

enum EstadoAtencion {
  ABIERTA
  SOLICITO_CUENTA
  PAGADA
  CERRADA
  ANULADA
}

enum EstadoPedido {
  NUEVO
  RECIBIDO
  PREPARANDO
  LISTO
  EN_ENTREGA
  ENTREGADO
  ANULADO
  PENDIENTE_CONFIRMACION
}

enum EstadoDetallePedido {
  NUEVO
  PREPARANDO
  LISTO
  ENTREGADO
  ANULADO
}

enum OrigenPedido {
  CLIENTE_QR
  MOZO
  CAJA
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TARJETA
  MIXTO
}
