generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */
enum TipoComprobante {
  NOTA_VENTA
  BOLETA
  FACTURA
}

enum RolUsuario {
  SUPERADMIN
  ADMINISTRADOR
  CAJERO
  MOZO
  COCINA
  BARRA
  GERENTE
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  PEDIDO_PENDIENTE
  CONSUMIENDO
  SOLICITO_CUENTA
  PAGADA
  LIMPIEZA
}

enum EstadoAtencion {
  ABIERTA
  SOLICITO_CUENTA
  PAGADA
  CERRADA
  ANULADA
}

enum EstadoPedido {
  PENDIENTE_CONFIRMACION
  NUEVO
  RECIBIDO
  PREPARANDO
  LISTO
  EN_ENTREGA
  ENTREGADO
  ANULADO
}

enum EstadoDetallePedido {
  NUEVO
  PREPARANDO
  LISTO
  ENTREGADO
  ANULADO
}

enum OrigenPedido {
  CLIENTE_QR
  MOZO
  CAJA
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TARJETA
  MIXTO
}

/**
 * =========================================================
 * EMPRESA
 * =========================================================
 */

model Empresa {
  id        String  @id @default(cuid())
  nombre    String
  ruc       String? @unique
  direccion String?
  telefono  String?
  correo    String?
  logoUrl   String?

  sucursales Sucursal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================================================
 * SUCURSAL
 * =========================================================
 */

model Sucursal {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre    String
  codigo    String
  direccion String?

  zonas      Zona[]
  usuarios   Usuario[]
  categorias Categoria[]
  productos  Producto[]
  atenciones Atencion[]
  pedidos    Pedido[]
  pagos      Pago[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  comprobantes Comprobante[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

/**
 * =========================================================
 * USUARIO
 * =========================================================
 */

model Usuario {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  nombres   String
  apellidos String
  correo    String     @unique
  password  String
  rol       RolUsuario
  activo    Boolean    @default(true)

  atencionesAsignadas Atencion[] @relation("MozoAtenciones")
  pedidosRegistrados  Pedido[]   @relation("UsuarioPedidos")
  pedidosRecibidos    Pedido[]   @relation("MozoRecibePedido")
  pedidosEntregados   Pedido[]   @relation("MozoEntregaPedido")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sucursalId])
  @@index([rol, activo])
}

/**
 * =========================================================
 * ZONA
 * =========================================================
 */

model Zona {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  nombre String

  mesas Mesa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sucursalId, nombre])
  @@index([sucursalId])
}

/**
 * =========================================================
 * MESA
 * =========================================================
 */

model Mesa {
  id String @id @default(cuid())

  zonaId String
  zona   Zona   @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  numero    Int
  nombre    String
  capacidad Int        @default(4)
  qrCode    String?    @unique
  estado    EstadoMesa @default(LIBRE)
  activa    Boolean    @default(true)

  atenciones Atencion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zonaId, numero])
  @@index([zonaId])
  @@index([estado, activa])
}

/**
 * =========================================================
 * CATEGORÍA
 * =========================================================
 */

model Categoria {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  codigo      String
  nombre      String
  descripcion String?
  activa      Boolean @default(true)

  productos Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@index([nombre])
  @@index([activa])
}

/**
 * =========================================================
 * PRODUCTO
 * =========================================================
 */

model Producto {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  codigo      String
  nombre      String
  descripcion String?

  precioVenta Decimal @db.Decimal(10, 2)
  costo       Decimal @default(0) @db.Decimal(10, 2)

  tiempoPreparacion Int @default(15)

  imagenUrl String?

  // ============================
  // CONTROL DE STOCK
  // ============================

  controlaStock Boolean @default(false)

  stockActual Decimal @default(0) @db.Decimal(12, 3)

  stockMinimo Decimal @default(0) @db.Decimal(12, 3)

  // ============================

  disponible Boolean @default(true)
  activo     Boolean @default(true)

  detallesPedido DetallePedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@index([categoriaId])
  @@index([nombre])
  @@index([disponible, activo])
  @@index([controlaStock])
}

/**
 * =========================================================
 * ATENCIÓN
 * =========================================================
 */

model Atencion {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  mesaId String
  mesa   Mesa   @relation(fields: [mesaId], references: [id], onDelete: Restrict)

  mozoId String?
  mozo   Usuario? @relation("MozoAtenciones", fields: [mozoId], references: [id], onDelete: SetNull)

  codigo String

  estado           EstadoAtencion @default(ABIERTA)
  cantidadPersonas Int            @default(1)

  metodoPagoPrevisto MetodoPago?

  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  observacion String?

  fechaApertura        DateTime  @default(now())
  fechaSolicitudCuenta DateTime?
  fechaPago            DateTime?
  fechaCierre          DateTime?

  pedidos Pedido[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  pagos        Pago[]
  comprobantes Comprobante[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@index([mesaId, estado])
  @@index([mozoId])
  @@index([fechaApertura])
}

/**
 * =========================================================
 * PEDIDO
 * =========================================================
 */

model Pedido {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  atencionId String
  atencion   Atencion @relation(fields: [atencionId], references: [id], onDelete: Cascade)

  registradoPorId String?
  registradoPor   Usuario? @relation("UsuarioPedidos", fields: [registradoPorId], references: [id], onDelete: SetNull)

  recibidoPorId String?
  recibidoPor   Usuario? @relation("MozoRecibePedido", fields: [recibidoPorId], references: [id], onDelete: SetNull)

  entregadoPorId String?
  entregadoPor   Usuario? @relation("MozoEntregaPedido", fields: [entregadoPorId], references: [id], onDelete: SetNull)

  numero String

  origen OrigenPedido
  estado EstadoPedido @default(NUEVO)

  observacion String?
  subtotal    Decimal @default(0) @db.Decimal(12, 2)

  fechaPedido      DateTime  @default(now())
  fechaRecibido    DateTime?
  fechaPreparacion DateTime?
  fechaListo       DateTime?
  fechaEntrega     DateTime?

  detalles DetallePedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sucursalId, numero])
  @@index([sucursalId])
  @@index([atencionId, estado])
  @@index([registradoPorId])
  @@index([recibidoPorId])
  @@index([entregadoPorId])
  @@index([fechaPedido])
}

/**
 * =========================================================
 * DETALLE DEL PEDIDO
 * =========================================================
 */

model DetallePedido {
  id String @id @default(cuid())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  cantidad       Decimal @db.Decimal(10, 3)
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  estado EstadoDetallePedido @default(NUEVO)

  observacion String?

  fechaPreparacion DateTime?
  fechaListo       DateTime?
  fechaEntrega     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pedidoId, estado])
  @@index([productoId])
}

model Pago {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  atencionId String
  atencion   Atencion @relation(fields: [atencionId], references: [id], onDelete: Restrict)

  metodo MetodoPago

  monto         Decimal  @db.Decimal(12, 2)
  montoRecibido Decimal? @db.Decimal(12, 2)
  vuelto        Decimal? @db.Decimal(12, 2)

  referencia  String?
  observacion String?

  fechaPago DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sucursalId])
  @@index([atencionId])
  @@index([metodo])
  @@index([fechaPago])
}

model Comprobante {
  id String @id @default(cuid())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  atencionId String
  atencion   Atencion @relation(fields: [atencionId], references: [id], onDelete: Restrict)

  tipo TipoComprobante

  serie       String
  correlativo Int

  numero String

  clienteDocumento String?
  clienteNombre    String?
  clienteDireccion String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  igv      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  emitido Boolean @default(true)

  fechaEmision DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sucursalId, tipo, serie, correlativo])
  @@unique([atencionId, tipo])
  @@index([sucursalId])
  @@index([atencionId])
  @@index([tipo])
  @@index([fechaEmision])
}
